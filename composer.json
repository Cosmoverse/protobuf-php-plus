{
    "name": "cosmicpe/protobuf-php-plus",
    "description": "AST post-processing for generated PHP protobuf classes",
    "type": "library",
    "require": {
        "php": ">=8.4",
        "google/protobuf": "^4.33",
        "nikic/php-parser": "^5.6",
        "composer-runtime-api": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "cosmicpe\\protobuf\\": "src/"
        }
    },
    "bin": [
        "bin/protop"
    ],
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "archive": {
        "exclude": ["/.tools", "/.github", "/generated", "/tests", "/vendor", "*.proto", "/example.php", "/phpunit.xml", "/verify-types.php"]
    }
}
